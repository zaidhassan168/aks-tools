#!/usr/bin/env bash
# kit — Kubernetes Interactive Toolkit for AKS.
# Combines the old aksc (rails console) and aksm (pods/logs/configmaps) into one CLI.
# Same picker flow: subscription -> cluster -> namespace -> action.
# No global `az account set`. Unique kube context per subscription+cluster.

set -euo pipefail

KIT_VERSION="1.3.2"

# ---------- Setup ----------
need() { command -v "$1" >/dev/null 2>&1 || { echo "Missing dependency: $1" >&2; exit 1; }; }
need kubectl
need az
need python3

KUBECTL="kubectl"
KUBE_CTX=""
SUB_ID=""
CLUSTER_NAME=""
CLUSTER_RG=""
NAMESPACE=""

# Non-interactive / agent mode. Flags pre-select sub/cluster/ns/pod/etc so no
# picker prompts fire. Auto-enabled when stdout is not a TTY (e.g. run by an
# agent) or KIT_NONINTERACTIVE=1. See show_help NON-INTERACTIVE section.
OPT_SUB=""; OPT_CLUSTER=""; OPT_NS=""; OPT_POD=""; OPT_DEPLOY=""; OPT_CM=""; OPT_SPC=""
OPT_TAIL=""; ASSUME_YES=0; OPT_CMD=()
KV_TMP=""
# Cluster credentials. By default kit keeps them only in a temp kubeconfig that
# is deleted on exit. Only an extension file can set KIT_KUBECONFIG to keep them
# in a fixed file instead (see EXTENSIONS in show_help).
KIT_USER_KUBECONFIG="${KUBECONFIG:-$HOME/.kube/config}"
KIT_KUBECONFIG=""
KIT_KUBECONFIG_DIR=""
ORPHAN_USER=""
KIT_STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/kit"
NONINTERACTIVE=0
[[ -t 1 ]] || NONINTERACTIVE=1
[[ -n "${KIT_NONINTERACTIVE:-}" ]] && NONINTERACTIVE=1

# Console-specific
KEEP_POD="${KEEP_POD:-0}"
ATTACH_MODE="${KIT_ATTACH_MODE:-attach}"
CONSOLE_POD=""
CONSOLE_NS=""
CONSOLE_CTX=""
CONSOLE_SUCCESS=0

die() { echo "Error: $*" >&2; exit 1; }
has_fzf() { command -v fzf >/dev/null 2>&1; }

# Local extensions: kit sources an optional private shell file at start (see
# EXTENSIONS in show_help). A hook runs only when the file defines it.
KIT_EXT_FILE="${KIT_EXTENSIONS:-${XDG_CONFIG_HOME:-$HOME/.config}/kit/extensions.sh}"
has_hook() { declare -F "$1" >/dev/null 2>&1; }

# Resolve exactly one item from a newline-separated list on stdin by
# case-insensitive substring match. Prints the match. Dies (listing options)
# on zero matches; dies on ambiguity when strict=1, else takes the first match.
# Usage: printf '%s\n' "$list" | resolve_one "<needle>" "<kind>" [strict]
resolve_one() {
  local needle="$1" kind="$2" strict="${3:-0}" list matches n
  list="$(cat)"
  matches="$(printf '%s\n' "$list" | grep -i -F -- "$needle" || true)"
  n="$(printf '%s\n' "$matches" | grep -c . || true)"
  [[ "$n" -eq 0 ]] && die "No $kind matching '$needle'. Available:"$'\n'"$(printf '%s\n' "$list" | sed 's/^/  - /')"
  if [[ "$strict" == "1" && "$n" -gt 1 ]]; then
    die "Ambiguous $kind '$needle' ($n matches). Be specific:"$'\n'"$(printf '%s\n' "$matches" | sed 's/^/  - /')"
  fi
  printf '%s\n' "$matches" | head -1
}

# Pager: less so the user can scroll/select/copy. -R raw colours, -X keep on screen
# after quit, -F auto-quit if output fits one page.
pager() { if [[ "$NONINTERACTIVE" == "1" ]]; then cat; else less -RXF; fi; }

# ---------- VPN (macOS, via scutil) ----------
# Cluster API servers are behind privatelink, so kit brings the VPN up before
# touching a cluster and tears it down on exit — but only if kit was the one
# that connected it. A VPN that was already up when kit started is left alone.
#   KIT_VPN=0             disable VPN handling entirely
#   KIT_VPN_SERVICE=name  service name from `scutil --nc list`
#                         (default: first enabled Azure VPN Client service)
#   KIT_VPN_KEEP=1        leave the VPN up on exit even if kit connected it
#   KIT_VPN_TIMEOUT=45    seconds to wait for the tunnel to report Connected
VPN_SERVICE=""
VPN_STARTED_BY_KIT=0

vpn_enabled() { [[ "${KIT_VPN:-1}" != "0" ]] && command -v scutil >/dev/null 2>&1; }

# Sets VPN_SERVICE (not echoed: must run in the main shell, not a subshell).
vpn_resolve_service() {
  [[ -z "$VPN_SERVICE" ]] || return 0
  if [[ -n "${KIT_VPN_SERVICE:-}" ]]; then
    VPN_SERVICE="$KIT_VPN_SERVICE"
  else
    VPN_SERVICE="$(scutil --nc list 2>/dev/null | grep '^\*' | grep -F 'AzureVpnMac' \
      | sed -n 's/.*"\([^"]*\)".*/\1/p' | head -1 || true)"
  fi
}

# First line of `scutil --nc status`: Connected | Connecting | Disconnected | Disconnecting.
# No `head` in a pipe here: under pipefail scutil's SIGPIPE would poison the result.
vpn_status() {
  local out
  out="$(scutil --nc status "$1" 2>/dev/null || true)"
  [[ -n "$out" ]] || { echo Unknown; return 0; }
  printf '%s\n' "${out%%$'\n'*}"
}

vpn_ensure() {
  vpn_enabled || return 0
  local svc st waited=0 timeout="${KIT_VPN_TIMEOUT:-45}"
  vpn_resolve_service
  svc="$VPN_SERVICE"
  [[ -n "$svc" ]] || return 0
  st="$(vpn_status "$svc")"
  case "$st" in
    Connected)
      echo "VPN: $svc already connected (kit will leave it up on exit)." >&2
      return 0 ;;
    Connecting*)
      echo "VPN: $svc is connecting (started outside kit), waiting..." >&2 ;;
    *)
      echo "VPN: connecting $svc..." >&2
      if ! scutil --nc start "$svc" >/dev/null 2>&1; then
        echo "VPN: could not start $svc; continuing without it." >&2
        return 0
      fi
      VPN_STARTED_BY_KIT=1 ;;
  esac
  while (( waited < timeout )); do
    st="$(vpn_status "$svc")"
    if [[ "$st" == Connected ]]; then
      echo "VPN: connected." >&2
      return 0
    fi
    sleep 1; waited=$((waited + 1))
  done
  echo "VPN: $svc not connected after ${timeout}s (status: $st). Cluster calls may fail." >&2
}

vpn_cleanup() {
  [[ "$VPN_STARTED_BY_KIT" -eq 1 ]] || return 0
  VPN_STARTED_BY_KIT=0
  if [[ "${KIT_VPN_KEEP:-0}" == "1" ]]; then
    echo "VPN: KIT_VPN_KEEP=1, leaving $VPN_SERVICE up." >&2
    return 0
  fi
  echo "VPN: disconnecting $VPN_SERVICE..." >&2
  scutil --nc stop "$VPN_SERVICE" >/dev/null 2>&1 || true
}

# ---------- Pickers ----------

pick_subscription() {
  echo "Fetching Azure subscriptions..." >&2
  local ids=() names=()
  while IFS=$'\t' read -r id name; do
    [[ -n "$id" ]] || continue
    ids+=("$id"); names+=("$name")
  done <<EOF
$(az account list --query "[].{id:id, name:name}" -o tsv 2>/dev/null || true)
EOF
  ((${#ids[@]})) || die "No Azure subscriptions found. Run: az login"
  if ((${#ids[@]}==1)); then echo "${ids[0]}"; return; fi
  if [[ -n "$OPT_SUB" ]]; then
    local hit="" i needle; needle="$(printf '%s' "$OPT_SUB" | tr 'A-Z' 'a-z')"
    for i in "${!ids[@]}"; do
      case "$(printf '%s' "${ids[$i]} ${names[$i]}" | tr 'A-Z' 'a-z')" in
        *"$needle"*) [[ -n "$hit" ]] && die "Ambiguous --sub '$OPT_SUB'. Matches more than one subscription."; hit="${ids[$i]}" ;;
      esac
    done
    [[ -n "$hit" ]] || die "No subscription matching '$OPT_SUB'. Available: ${names[*]}"
    echo "$hit"; return
  fi
  [[ "$NONINTERACTIVE" == "1" ]] && die "Multiple subscriptions; pass --sub <name|id>"
  if has_fzf; then
    local selected
    selected="$(for i in "${!ids[@]}"; do printf "%s\t%s\n" "${names[$i]}" "${ids[$i]}"; done \
      | fzf --with-nth=1 --delimiter=$'\t' --prompt="Subscription > " --height=40% --reverse)"
    [[ -n "$selected" ]] || exit 1
    echo "$selected" | awk -F'\t' '{print $2}'
  else
    echo "Select subscription:" >&2
    for i in "${!ids[@]}"; do printf "%2d) %s (%s)\n" "$((i+1))" "${names[$i]}" "${ids[$i]}" >&2; done
    while true; do
      read -rp "> " n
      [[ "$n" =~ ^[0-9]+$ ]] && (( n>=1 && n<=${#ids[@]} )) && { echo "${ids[$((n-1))]}"; return; }
      echo "Invalid selection." >&2
    done
  fi
}

pick_aks_cluster() {
  local sub_id="$1"
  local hit_ext
  if has_hook kit_ext_pick_cluster && hit_ext="$(kit_ext_pick_cluster "$sub_id" start)" && [[ -n "$hit_ext" ]]; then
    echo "$hit_ext"; return
  fi
  echo "Fetching AKS clusters..." >&2
  local err_file; err_file="$(mktemp)"
  local raw; raw="$(az aks list --subscription "$sub_id" --query "[].{name:name, rg:resourceGroup}" -o tsv 2>"$err_file" || true)"
  local err; err="$(cat "$err_file")"; rm -f "$err_file"
  local c_names=() c_rgs=()
  while IFS=$'\t' read -r name rg; do
    [[ -n "$name" ]] || continue
    c_names+=("$name"); c_rgs+=("$rg")
  done <<EOF
$raw
EOF
  if ((${#c_names[@]}==0)); then
    echo >&2
    echo "No AKS clusters visible in subscription $sub_id." >&2
    if [[ -n "$err" ]]; then
      echo "az error: $err" >&2
    else
      echo "Likely cause: Reader role on this subscription is not active." >&2
    fi
    if has_hook kit_ext_pick_cluster && hit_ext="$(kit_ext_pick_cluster "$sub_id" denied)" && [[ -n "$hit_ext" ]]; then
      echo "$hit_ext"; return
    fi
    die "Activate your PIM role for this subscription (Azure Portal -> PIM), then run: az account clear && az login"
  fi
  if ((${#c_names[@]}==1)); then echo "${c_names[0]}|${c_rgs[0]}"; return; fi
  if [[ -n "$OPT_CLUSTER" ]]; then
    local hit="" i needle; needle="$(printf '%s' "$OPT_CLUSTER" | tr 'A-Z' 'a-z')"
    for i in "${!c_names[@]}"; do
      case "$(printf '%s' "${c_names[$i]}" | tr 'A-Z' 'a-z')" in
        *"$needle"*) [[ -n "$hit" ]] && die "Ambiguous --cluster '$OPT_CLUSTER'."; hit="${c_names[$i]}|${c_rgs[$i]}" ;;
      esac
    done
    [[ -n "$hit" ]] || die "No cluster matching '$OPT_CLUSTER' in subscription $sub_id"
    echo "$hit"; return
  fi
  [[ "$NONINTERACTIVE" == "1" ]] && die "Multiple clusters; pass --cluster <name>"
  if has_fzf; then
    local selected
    selected="$(for i in "${!c_names[@]}"; do printf "%s\t%s\n" "${c_names[$i]}" "${c_rgs[$i]}"; done \
      | fzf --with-nth=1 --delimiter=$'\t' --prompt="Cluster > " --height=40% --reverse)"
    [[ -n "$selected" ]] || exit 1
    echo "$(echo "$selected" | awk -F'\t' '{print $1}')|$(echo "$selected" | awk -F'\t' '{print $2}')"
  else
    echo "Select cluster:" >&2
    for i in "${!c_names[@]}"; do printf "%2d) %s (RG: %s)\n" "$((i+1))" "${c_names[$i]}" "${c_rgs[$i]}" >&2; done
    while true; do
      read -rp "> " n
      [[ "$n" =~ ^[0-9]+$ ]] && (( n>=1 && n<=${#c_names[@]} )) && { echo "${c_names[$((n-1))]}|${c_rgs[$((n-1))]}"; return; }
      echo "Invalid selection." >&2
    done
  fi
}

list_ns() { $KUBECTL --context "$KUBE_CTX" get ns -o custom-columns=NAME:.metadata.name --no-headers; }

# The last namespace picked on each kube context, so the picker can offer it first.
ns_last_get() {
  awk -F'\t' -v c="$KUBE_CTX" '$1==c {v=$2} END {if (v!="") print v}' "$KIT_STATE_DIR/last-ns" 2>/dev/null || true
}

ns_last_set() {
  [[ -n "${1:-}" ]] || return 0
  mkdir -p "$KIT_STATE_DIR" 2>/dev/null || return 0
  local f="$KIT_STATE_DIR/last-ns"
  { awk -F'\t' -v c="$KUBE_CTX" '$1!=c' "$f" 2>/dev/null || true; printf '%s\t%s\n' "$KUBE_CTX" "$1"; } > "$f.tmp" 2>/dev/null \
    && mv "$f.tmp" "$f" 2>/dev/null || true
}

list_ns_last_first() {
  local all last
  all="$(list_ns)"
  last="$(ns_last_get)"
  if [[ -n "$last" ]] && printf '%s\n' "$all" | grep -qxF -- "$last"; then
    printf '%s\n' "$last"
    printf '%s\n' "$all" | grep -vxF -- "$last" || true
  else
    printf '%s\n' "$all"
  fi
}

pick_ns() {
  if [[ -n "$OPT_NS" ]]; then list_ns | resolve_one "$OPT_NS" "namespace" 0; return; fi
  [[ "$NONINTERACTIVE" == "1" ]] && die "Non-interactive: pass --ns <name>"
  if has_fzf; then
    list_ns_last_first | fzf --prompt="Namespace > " --header="Last used is first" --height=40% --reverse
  else
    local items=()
    while IFS= read -r line; do [[ -n "$line" ]] && items+=("$line"); done <<EOF
$(list_ns_last_first)
EOF
    ((${#items[@]})) || die "No namespaces found."
    echo "Select a namespace:" >&2
    for i in "${!items[@]}"; do printf "%2d) %s\n" "$((i+1))" "${items[$i]}" >&2; done
    while true; do
      read -rp "> " n
      [[ "$n" =~ ^[0-9]+$ ]] && (( n>=1 && n<=${#items[@]} )) && { echo "${items[$((n-1))]}"; return; }
      echo "Invalid selection." >&2
    done
  fi
}

pick_pod() {
  local ns="$1"
  if [[ -n "$OPT_POD" ]]; then
    $KUBECTL --context "$KUBE_CTX" -n "$ns" get pods -o custom-columns=NAME:.metadata.name --no-headers 2>/dev/null \
      | resolve_one "$OPT_POD" "pod" 0; return
  fi
  [[ "$NONINTERACTIVE" == "1" ]] && die "Non-interactive: pass --pod <name-substring> for namespace '$ns'"
  local pods=()
  while IFS= read -r line; do [[ -n "$line" ]] && pods+=("$line"); done <<EOF
$($KUBECTL --context "$KUBE_CTX" -n "$ns" get pods -o custom-columns=NAME:.metadata.name,STATUS:.status.phase,RESTARTS:.status.containerStatuses[0].restartCount --no-headers 2>/dev/null || true)
EOF
  ((${#pods[@]})) || die "No pods found in $ns"
  if has_fzf; then
    printf "%s\n" "${pods[@]}" | fzf --prompt="Pod > " --height=40% --reverse | awk '{print $1}'
  else
    echo "Select a pod:" >&2
    for i in "${!pods[@]}"; do printf "%2d) %s\n" "$((i+1))" "${pods[$i]}" >&2; done
    while true; do
      read -rp "> " n
      [[ "$n" =~ ^[0-9]+$ ]] && (( n>=1 && n<=${#pods[@]} )) && { echo "${pods[$((n-1))]}" | awk '{print $1}'; return; }
      echo "Invalid selection." >&2
    done
  fi
}

pick_configmap() {
  local ns="$1"
  if [[ -n "$OPT_CM" ]]; then
    $KUBECTL --context "$KUBE_CTX" -n "$ns" get cm -o custom-columns=NAME:.metadata.name --no-headers 2>/dev/null \
      | grep -v kube-root-ca | resolve_one "$OPT_CM" "configmap" 0; return
  fi
  [[ "$NONINTERACTIVE" == "1" ]] && die "Non-interactive: pass --cm <name-substring> for namespace '$ns'"
  local cms=()
  while IFS= read -r line; do [[ -n "$line" ]] && cms+=("$line"); done <<EOF
$($KUBECTL --context "$KUBE_CTX" -n "$ns" get cm -o custom-columns=NAME:.metadata.name --no-headers 2>/dev/null | grep -v kube-root-ca || true)
EOF
  ((${#cms[@]})) || die "No configmaps found in $ns"
  if ((${#cms[@]}==1)); then echo "${cms[0]}"; return; fi
  if has_fzf; then
    printf "%s\n" "${cms[@]}" | fzf --prompt="ConfigMap > " --height=40% --reverse
  else
    echo "Select a ConfigMap:" >&2
    for i in "${!cms[@]}"; do printf "%2d) %s\n" "$((i+1))" "${cms[$i]}" >&2; done
    while true; do
      read -rp "> " n
      [[ "$n" =~ ^[0-9]+$ ]] && (( n>=1 && n<=${#cms[@]} )) && { echo "${cms[$((n-1))]}"; return; }
      echo "Invalid selection." >&2
    done
  fi
}

pick_deployment() {
  local ns="$1"
  if [[ -n "$OPT_DEPLOY" ]]; then
    $KUBECTL --context "$KUBE_CTX" -n "$ns" get deploy -o custom-columns=NAME:.metadata.name --no-headers 2>/dev/null \
      | resolve_one "$OPT_DEPLOY" "deployment" 0; return
  fi
  [[ "$NONINTERACTIVE" == "1" ]] && die "Non-interactive: pass --deploy <name-substring> for namespace '$ns'"
  local deploys=()
  while IFS= read -r d; do [[ -n "$d" ]] && deploys+=("$d"); done <<EOF
$($KUBECTL --context "$KUBE_CTX" -n "$ns" get deploy -o custom-columns=NAME:.metadata.name --no-headers 2>/dev/null || true)
EOF
  ((${#deploys[@]})) || die "No deployments found in $ns"
  if ((${#deploys[@]}==1)); then echo "${deploys[0]}"; return; fi
  if has_fzf; then
    printf "%s\n" "${deploys[@]}" | fzf --prompt="Deployment > " --height=40% --reverse
  else
    echo "Select deployment:" >&2
    for i in "${!deploys[@]}"; do printf "%2d) %s\n" "$((i+1))" "${deploys[$i]}" >&2; done
    while true; do
      read -rp "> " n
      [[ "$n" =~ ^[0-9]+$ ]] && (( n>=1 && n<=${#deploys[@]} )) && { echo "${deploys[$((n-1))]}"; return; }
      echo "Invalid selection." >&2
    done
  fi
}

# ---------- Credentials ----------

ensure_creds() {
  local sub_id="$1" rg="$2" cluster="$3" ctx="$4"
  echo "Getting AKS credentials for $cluster..." >&2
  local err
  if ! err="$(az aks get-credentials \
      --subscription "$sub_id" --resource-group "$rg" --name "$cluster" \
      --overwrite-existing --context "$ctx" --file "$KIT_KUBECONFIG" 2>&1 >/dev/null)"; then
    echo "Error: Failed to get AKS credentials." >&2
    echo "$err" >&2
    exit 1
  fi
}

# ---------- Kubeconfig ----------

# Uses the extension's fixed kubeconfig when it set one. Otherwise creates a
# private temp kubeconfig for this run, which kit_exit deletes.
kubeconfig_setup() {
  if [[ -z "$KIT_KUBECONFIG" ]]; then
    KIT_KUBECONFIG_DIR="$(mktemp -d "${TMPDIR:-/tmp}/kit.XXXXXX")"
    chmod 700 "$KIT_KUBECONFIG_DIR"
    KIT_KUBECONFIG="$KIT_KUBECONFIG_DIR/config"
  fi
  export KUBECONFIG="$KIT_KUBECONFIG"
}

kubeconfig_cleanup() {
  [[ -n "$KIT_KUBECONFIG_DIR" ]] || return 0
  rm -f "$KIT_KUBECONFIG_DIR/config" "$KIT_KUBECONFIG_DIR/config.lock"
  rmdir "$KIT_KUBECONFIG_DIR" 2>/dev/null || true
  KIT_KUBECONFIG_DIR=""
}

# Older kit and aksc versions left kit-* / aksc-* contexts in the user's own
# kubeconfig. Remove them quietly, with their user and cluster entries when no
# other context still uses those entries.
forget_old_contexts() {
  local plan kind name
  plan="$(KUBECONFIG="$KIT_USER_KUBECONFIG" kubectl config view -o json 2>/dev/null | python3 -c '
import sys, json
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
ctxs = {c["name"]: (c.get("context") or {}) for c in d.get("contexts") or []}
old = [n for n in ctxs if n.startswith(("kit-", "aksc-"))]
if not old:
    sys.exit(0)
keep = [c for n, c in ctxs.items() if n not in old]
for n in old:
    print("context\t" + n)
for kind in ("user", "cluster"):
    used = {c.get(kind) for c in keep}
    for v in sorted({ctxs[n].get(kind) for n in old} - used - {None}):
        print(kind + "\t" + v)
')" || true
  [[ -n "$plan" ]] || return 0
  while IFS=$'\t' read -r kind name; do
    KUBECONFIG="$KIT_USER_KUBECONFIG" kubectl config "delete-$kind" "$name" >/dev/null 2>&1 || true
  done <<< "$plan"
}

# ---------- Read commands (paged) ----------

cmd_pods() {
  local ns="$1"
  {
    echo "=== Pods in $ns ==="
    $KUBECTL --context "$KUBE_CTX" -n "$ns" get pods -o wide
  } | pager
}

cmd_logs() {
  local ns="$1"
  local pod; pod="$(pick_pod "$ns")" || return 1
  [[ -n "$pod" ]] || return 1
  local tail="${OPT_TAIL:-${2:-200}}"
  {
    echo "=== Logs for $pod (tail $tail) ==="
    $KUBECTL --context "$KUBE_CTX" -n "$ns" logs "$pod" --tail="$tail" --all-containers=true
  } | pager
}

cmd_logs_follow() {
  local ns="$1"
  local pod; pod="$(pick_pod "$ns")" || return 1
  [[ -n "$pod" ]] || return 1
  echo "=== Following logs for $pod (Ctrl+C to stop) ==="
  $KUBECTL --context "$KUBE_CTX" -n "$ns" logs "$pod" -f --all-containers=true || true
}

cmd_describe() {
  local ns="$1"
  local pod; pod="$(pick_pod "$ns")" || return 1
  [[ -n "$pod" ]] || return 1
  $KUBECTL --context "$KUBE_CTX" -n "$ns" describe pod "$pod" | pager
}

cmd_events() {
  local ns="$1"
  {
    echo "=== Recent events in $ns ==="
    $KUBECTL --context "$KUBE_CTX" -n "$ns" get events --sort-by=.lastTimestamp | tail -50
  } | pager
}

cmd_cm_view() {
  local ns="$1"
  local cm; cm="$(pick_configmap "$ns")" || return 1
  [[ -n "$cm" ]] || return 1
  {
    echo "=== ConfigMap: $cm ==="
    $KUBECTL --context "$KUBE_CTX" -n "$ns" get cm "$cm" -o yaml
  } | pager
}

cmd_cm_get() {
  local ns="$1"
  local cm; cm="$(pick_configmap "$ns")" || return 1
  [[ -n "$cm" ]] || return 1
  {
    echo "=== ConfigMap: $cm (data only) ==="
    $KUBECTL --context "$KUBE_CTX" -n "$ns" get cm "$cm" -o jsonpath='{.data}' \
      | python3 -m json.tool 2>/dev/null \
      || $KUBECTL --context "$KUBE_CTX" -n "$ns" get cm "$cm" -o jsonpath='{.data}'
    echo
  } | pager
}

# ---------- Mutating commands ----------

# Succeeds when a workload in the namespace reads the ConfigMap (envFrom, env
# valueFrom or a volume). Also succeeds when kubectl output can't be parsed, so
# a read failure never blocks an edit.
cm_in_use() {
  local ns="$1" cm="$2"
  $KUBECTL --context "$KUBE_CTX" -n "$ns" get deploy,statefulset,daemonset,cronjob -o json 2>/dev/null | python3 -c '
import sys, json
cm = sys.argv[1]
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
def walk(o):
    if isinstance(o, dict):
        for k in ("configMapRef", "configMapKeyRef", "configMap"):
            v = o.get(k)
            if isinstance(v, dict) and v.get("name") == cm:
                return True
        return any(walk(v) for v in o.values())
    if isinstance(o, list):
        return any(walk(v) for v in o)
    return False
sys.exit(0 if walk(d) else 1)
' "$cm"
}

# Returns non-zero when the user backs out of editing an unused ConfigMap.
cm_confirm_unused() {
  local ns="$1" cm="$2" confirm
  cm_in_use "$ns" "$cm" && return 0
  echo "Warning: no workload in $ns reads ConfigMap $cm, so this edit has no effect on the apps." >&2
  if $KUBECTL --context "$KUBE_CTX" -n "$ns" get secretproviderclass --no-headers 2>/dev/null | grep -q .; then
    echo "This namespace reads env from Azure Key Vault. Use 'kit kv-set' instead." >&2
  fi
  read -rp "Edit it anyway? (y/n) > " confirm
  [[ "$confirm" == "y" || "$confirm" == "Y" ]]
}

cmd_cm_set() {
  local ns="$1"
  local cm; cm="$(pick_configmap "$ns")" || return 1
  [[ -n "$cm" ]] || return 1
  cm_confirm_unused "$ns" "$cm" || { echo "Cancelled."; return 0; }
  echo "Set configmap values (KEY=VALUE). Empty line to finish."
  local patch_data="{" first=1
  while true; do
    read -rp "  KEY=VALUE> " kv
    [[ -z "$kv" ]] && break
    if [[ "$kv" != *"="* ]]; then echo "  Invalid format. Use KEY=VALUE" >&2; continue; fi
    local key="${kv%%=*}" val="${kv#*=}"
    [[ $first -eq 1 ]] && first=0 || patch_data+=","
    val="${val//\"/\\\"}"
    patch_data+="\"$key\":\"$val\""
  done
  patch_data+="}"
  if [[ "$patch_data" == "{}" ]]; then echo "No values provided, skipping." >&2; return; fi
  echo
  echo "Patching $cm with: $patch_data"
  read -rp "Confirm? (y/n) > " confirm
  if [[ "$confirm" == "y" || "$confirm" == "Y" ]]; then
    $KUBECTL --context "$KUBE_CTX" -n "$ns" patch configmap "$cm" --type merge -p "{\"data\":$patch_data}"
    echo "Done. Run 'kit restart' to apply changes."
  else
    echo "Cancelled."
  fi
}

cmd_cm_del() {
  local ns="$1"
  local cm; cm="$(pick_configmap "$ns")" || return 1
  [[ -n "$cm" ]] || return 1
  cm_confirm_unused "$ns" "$cm" || { echo "Cancelled."; return 0; }
  echo "Current keys in $cm:"
  local keys=()
  while IFS= read -r k; do [[ -n "$k" ]] && keys+=("$k"); done <<EOF
$($KUBECTL --context "$KUBE_CTX" -n "$ns" get cm "$cm" -o json 2>/dev/null \
  | python3 -c 'import sys,json; print("\n".join(json.load(sys.stdin).get("data",{}).keys()))')
EOF
  ((${#keys[@]})) || { echo "No keys in this configmap." >&2; return; }
  local key
  if has_fzf; then
    key="$(printf "%s\n" "${keys[@]}" | fzf --prompt="Key to delete > " --height=40% --reverse)"
  else
    for i in "${!keys[@]}"; do printf "%2d) %s\n" "$((i+1))" "${keys[$i]}" >&2; done
    read -rp "Key number > " n
    [[ "$n" =~ ^[0-9]+$ ]] && (( n>=1 && n<=${#keys[@]} )) && key="${keys[$((n-1))]}"
  fi
  [[ -n "${key:-}" ]] || return
  read -rp "Delete key '$key' from $cm? (y/n) > " confirm
  if [[ "$confirm" == "y" || "$confirm" == "Y" ]]; then
    $KUBECTL --context "$KUBE_CTX" -n "$ns" patch configmap "$cm" --type json -p "[{\"op\":\"remove\",\"path\":\"/data/$key\"}]"
    echo "Deleted '$key'. Run 'kit restart' to apply."
  fi
}

# ---------- Key Vault (Secrets Store CSI) ----------
# Charts that moved env to Azure Key Vault ship a SecretProviderClass (SPC). Its
# secretObjects map each Key Vault object to an env key in a K8s secret that the
# CSI driver keeps in sync. kit reads that live mapping instead of guessing
# object names, because prefixes and overrides differ per chart.

pick_spc() {
  local ns="$1" list
  list="$($KUBECTL --context "$KUBE_CTX" -n "$ns" get secretproviderclass -o custom-columns=NAME:.metadata.name --no-headers 2>/dev/null || true)"
  [[ -n "$list" ]] || die "No SecretProviderClass in $ns. This namespace still reads a ConfigMap: use cm-get/cm-set."
  if [[ -n "$OPT_SPC" ]]; then printf '%s\n' "$list" | resolve_one "$OPT_SPC" "secretproviderclass" 1; return; fi
  local items=()
  while IFS= read -r line; do [[ -n "$line" ]] && items+=("$line"); done <<< "$list"
  if ((${#items[@]}==1)); then echo "${items[0]}"; return; fi
  [[ "$NONINTERACTIVE" == "1" ]] && die "Non-interactive: pass --spc <name-substring> for namespace '$ns'"
  if has_fzf; then
    printf "%s\n" "${items[@]}" | fzf --prompt="SecretProviderClass > " --height=40% --reverse
  else
    echo "Select a SecretProviderClass:" >&2
    for i in "${!items[@]}"; do printf "%2d) %s\n" "$((i+1))" "${items[$i]}" >&2; done
    while true; do
      read -rp "> " n
      [[ "$n" =~ ^[0-9]+$ ]] && (( n>=1 && n<=${#items[@]} )) && { echo "${items[$((n-1))]}"; return; }
      echo "Invalid selection." >&2
    done
  fi
}

# Line 1: the vault name. Then one line per key: <env key> TAB <kv object> TAB <k8s secret>.
kv_map() {
  local ns="$1" spc="$2"
  $KUBECTL --context "$KUBE_CTX" -n "$ns" get secretproviderclass "$spc" -o json 2>/dev/null | python3 -c '
import sys, json
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(1)
spec = d.get("spec") or {}
vault = (spec.get("parameters") or {}).get("keyvaultName", "")
rows = []
for so in spec.get("secretObjects") or []:
    for item in so.get("data") or []:
        rows.append("\t".join([item.get("key", ""), item.get("objectName", ""), so.get("secretName", "")]))
if not vault or not rows:
    sys.exit(1)
print(vault)
print("\n".join(sorted(rows)))
'
}

cmd_kv_get() {
  local ns="$1" spc map vault rows secret
  spc="$(pick_spc "$ns")" || return 1
  [[ -n "$spc" ]] || return 1
  map="$(kv_map "$ns" "$spc")" || die "Could not read the Key Vault mapping from $spc."
  vault="${map%%$'\n'*}"; rows="${map#*$'\n'}"
  {
    echo "=== Key Vault: $vault (SecretProviderClass: $spc) ==="
    echo "=== Values as synced into the K8s secret the pods read ==="
    for secret in $(printf '%s\n' "$rows" | cut -f3 | sort -u); do
      echo "--- secret/$secret"
      $KUBECTL --context "$KUBE_CTX" -n "$ns" get secret "$secret" -o json 2>/dev/null | python3 -c '
import sys, json, base64
secret, rows = sys.argv[1], sys.argv[2]
try:
    data = json.load(sys.stdin).get("data") or {}
except Exception:
    data = None
if data is None:
    print("  (secret not found: no running pod has synced it yet)")
for line in rows.splitlines():
    key, obj, sec = line.split("\t")
    if sec != secret or data is None:
        continue
    val = base64.b64decode(data[key]).decode("utf-8", "replace").replace("\n", "\\n") if key in data else "<not synced>"
    print(key + "=" + val + "    [kv: " + obj + "]")
' "$secret" "$rows"
    done
  } | pager
}

# Waits until the synced K8s secret holds the new values. Args: lines of
# <k8s secret> TAB <env key> TAB <sha256 of new value>.
kv_wait_sync() {
  local ns="$1" expect="$2" deadline=$(( $(date +%s) + 180 )) secret pending
  echo "Waiting for the CSI driver to sync the new values (it polls about every 2 minutes)..."
  while true; do
    pending=0
    for secret in $(printf '%s\n' "$expect" | cut -f1 | sort -u); do
      $KUBECTL --context "$KUBE_CTX" -n "$ns" get secret "$secret" -o json 2>/dev/null | python3 -c '
import sys, json, base64, hashlib
secret, expect = sys.argv[1], sys.argv[2]
try:
    data = json.load(sys.stdin).get("data") or {}
except Exception:
    sys.exit(1)
for line in expect.splitlines():
    sec, key, sha = line.split("\t")
    if sec != secret:
        continue
    if key not in data or hashlib.sha256(base64.b64decode(data[key])).hexdigest() != sha:
        sys.exit(1)
' "$secret" "$expect" || pending=1
    done
    (( pending == 0 )) && { echo "Synced."; return 0; }
    (( $(date +%s) > deadline )) && { echo "Not synced after 3 minutes. Restarted pods still read Key Vault on mount." >&2; return 1; }
    sleep 10
  done
}

# Rollout-restarts the given deployments, then waits for each rollout.
restart_deployments() {
  local ns="$1" d; shift
  for d in "$@"; do
    echo "Restarting deployment $d..."
    $KUBECTL --context "$KUBE_CTX" -n "$ns" rollout restart deployment "$d"
  done
  echo "Watching rollout..."
  for d in "$@"; do
    $KUBECTL --context "$KUBE_CTX" -n "$ns" rollout status deployment "$d" --timeout=300s || true
  done
}

# Rollout-restarts, after one confirmation, every deployment that reads one of the given K8s secrets.
kv_restart_readers() {
  local ns="$1" secrets="$2" deploys confirm
  deploys="$($KUBECTL --context "$KUBE_CTX" -n "$ns" get deploy -o json 2>/dev/null | python3 -c '
import sys, json
secrets = set(sys.argv[1].split())
try:
    items = json.load(sys.stdin).get("items") or []
except Exception:
    items = []
def reads(o):
    if isinstance(o, dict):
        for k in ("secretRef", "secretKeyRef"):
            v = o.get(k)
            if isinstance(v, dict) and v.get("name") in secrets:
                return True
        return any(reads(v) for v in o.values())
    if isinstance(o, list):
        return any(reads(v) for v in o)
    return False
for it in items:
    if reads((it.get("spec") or {}).get("template")):
        print(it["metadata"]["name"])
' "$secrets")"
  if [[ -z "$deploys" ]]; then
    echo "No deployment in $ns reads $secrets. Nothing to restart." >&2
    return 0
  fi
  echo
  echo "Env vars are read at pod start. These deployments need a restart to use the new values:"
  printf '  - %s\n' $deploys
  echo "CronJobs pick up the new values on their next run."
  read -rp "Restart them now? (y/n) > " confirm
  [[ "$confirm" == "y" || "$confirm" == "Y" ]] || { echo "Not restarted. Run 'kit restart-all' later."; return 0; }
  restart_deployments "$ns" $deploys
}

# Prints one value from a K8s secret. Fails when the secret or key is missing.
secret_value() {
  $KUBECTL --context "$KUBE_CTX" -n "$1" get secret "$2" -o json 2>/dev/null | python3 -c '
import sys, json, base64
try:
    data = json.load(sys.stdin).get("data") or {}
except Exception:
    sys.exit(1)
if sys.argv[1] not in data:
    sys.exit(1)
sys.stdout.write(base64.b64decode(data[sys.argv[1]]).decode("utf-8", "replace"))
' "$3"
}

# Shortens a value for one-line display.
short_value() {
  local v="${1//$'\n'/\\n}"
  if (( ${#v} > 60 )); then printf '%s... (%d chars)' "${v:0:60}" "${#v}"; else printf '%s' "$v"; fi
}

# Explains how to add a key that the SPC does not list. Args: spc, vault, rows, [env key].
kv_new_key_help() {
  local spc="$1" vault="$2" rows="$3" key="${4:-}" prefix obj
  prefix="$(printf '%s\n' "$rows" | cut -f2 | python3 -c '
import sys, os
names = [l.strip() for l in sys.stdin if l.strip()]
p = os.path.commonprefix(names)
print(p[:p.rfind("-") + 1] if "-" in p else "")
')"
  obj="${prefix}<key-in-lowercase-with-dashes>"
  [[ -n "$key" ]] && obj="${prefix}$(printf '%s' "$key" | tr 'A-Z_' 'a-z-')"
  cat >&2 <<MSG
  kit only changes keys that already exist in $spc. To add ${key:-a new key}:
    1. Add the secret '$obj' to Key Vault $vault.
    2. Add the line '$obj' to the SecretProviderClass template in the app's
       Helm chart and open a PR. If the env key needs another name, add an
       override in that template.
    3. Deploy the app. The new pods then get the key.
MSG
}

# Lets the user choose existing keys only. Prints the chosen rows
# (<env key> TAB <kv object> TAB <k8s secret>). A name that is not in the
# SPC is reported as missing, with the steps to add it.
kv_pick_keys() {
  local spc="$1" vault="$2" rows="$3" out query sel=""
  if has_fzf; then
    out="$(printf '%s\n' "$rows" | fzf --multi --print-query --delimiter=$'\t' --with-nth=1 \
      --prompt="Key > " --header="Existing keys in $spc (Tab = choose more than one)" \
      --height=60% --reverse || true)"
    query="${out%%$'\n'*}"
    [[ "$out" == *$'\n'* ]] && sel="${out#*$'\n'}"
    if [[ -z "$sel" ]]; then
      if [[ -n "$query" ]]; then
        echo "'$query' does not exist in $spc." >&2
        kv_new_key_help "$spc" "$vault" "$rows" "$query"
      fi
      return 1
    fi
    printf '%s\n' "$sel"
    return 0
  fi
  local items=() line i n hit answer parts
  while IFS= read -r line; do [[ -n "$line" ]] && items+=("$line"); done <<< "$rows"
  echo "Existing keys in $spc:" >&2
  for i in "${!items[@]}"; do printf "%3d) %s\n" "$((i+1))" "${items[$i]%%$'\t'*}" >&2; done
  read -rp "Numbers (comma-separated) or a key name > " answer
  [[ -n "$answer" ]] || return 1
  IFS=',' read -ra parts <<< "$answer"
  ((${#parts[@]})) || return 1
  for n in "${parts[@]}"; do
    n="$(printf '%s' "$n" | tr -d ' ')"
    [[ -n "$n" ]] || continue
    if [[ "$n" =~ ^[0-9]+$ ]] && (( n>=1 && n<=${#items[@]} )); then
      sel+="${items[$((n-1))]}"$'\n'
      continue
    fi
    hit="$(printf '%s\n' "$rows" | awk -F'\t' -v k="$n" 'toupper($1)==toupper(k) {print; exit}')"
    if [[ -n "$hit" ]]; then
      sel+="$hit"$'\n'
    else
      echo "'$n' does not exist in $spc." >&2
      kv_new_key_help "$spc" "$vault" "$rows" "$n"
    fi
  done
  [[ -n "$sel" ]] || return 1
  printf '%s' "$sel"
}

# Updates existing Key Vault values only. A new key also needs the chart's
# SecretProviderClass list in the app's Helm chart and a deploy, or no pod sees it.
cmd_kv_set() {
  local ns="$1"
  [[ -t 0 ]] || die "kv-set needs a terminal: it asks for the new values."
  command -v shasum >/dev/null 2>&1 || die "Missing dependency: shasum"
  local spc map vault rows picked
  spc="$(pick_spc "$ns")" || return 1
  [[ -n "$spc" ]] || return 1
  map="$(kv_map "$ns" "$spc")" || die "Could not read the Key Vault mapping from $spc."
  vault="${map%%$'\n'*}"; rows="${map#*$'\n'}"
  echo "Key Vault: $vault (SecretProviderClass: $spc, $(printf '%s\n' "$rows" | grep -c .) keys)"
  picked="$(kv_pick_keys "$spc" "$vault" "$rows")" || { echo "No key chosen. Nothing changed."; return 0; }

  local keys=() objs=() secs=() curs=() vals=() key obj sec
  while IFS=$'\t' read -r key obj sec; do
    [[ -n "$key" ]] || continue
    keys+=("$key"); objs+=("$obj"); secs+=("$sec")
  done <<< "$picked"
  ((${#keys[@]})) || { echo "No key chosen. Nothing changed."; return 0; }

  echo
  local i cur val chosen=()
  for i in "${!keys[@]}"; do
    cur="$(secret_value "$ns" "${secs[$i]}" "${keys[$i]}")" || cur="<not synced>"
    echo "${keys[$i]} (Key Vault: ${objs[$i]})"
    echo "  current: $(short_value "$cur")"
    read -rp "  new value (empty = keep) > " val
    if [[ -z "$val" || "$val" == "$cur" ]]; then echo "  unchanged."; continue; fi
    curs+=("$cur"); vals+=("$val"); chosen+=("$i")
  done
  ((${#chosen[@]})) || { echo "No values changed. Nothing written."; return 0; }

  echo
  echo "Will write to Key Vault $vault:"
  local j
  for j in "${!chosen[@]}"; do
    i="${chosen[$j]}"
    echo "  ${keys[$i]}: $(short_value "${curs[$j]}")  ->  $(short_value "${vals[$j]}")"
  done
  local confirm
  read -rp "Confirm? (y/n) > " confirm
  [[ "$confirm" == "y" || "$confirm" == "Y" ]] || { echo "Cancelled."; return 0; }

  # Values go through a 0600 temp file, not argv, so they stay out of `ps` and
  # values that start with '-' are not read as flags.
  KV_TMP="$(mktemp)"; chmod 600 "$KV_TMP"
  local expect="" written_secrets="" failed=0 sha
  for j in "${!chosen[@]}"; do
    i="${chosen[$j]}"
    printf '%s' "${vals[$j]}" > "$KV_TMP"
    if az keyvault secret set --vault-name "$vault" --name "${objs[$i]}" --file "$KV_TMP" --encoding utf-8 --output none; then
      echo "  set ${keys[$i]}"
      sha="$(shasum -a 256 "$KV_TMP" | awk '{print $1}')"
      expect+="${secs[$i]}"$'\t'"${keys[$i]}"$'\t'"$sha"$'\n'
      written_secrets+="${secs[$i]} "
    else
      echo "  FAILED ${keys[$i]}" >&2
      failed=1
    fi
  done
  rm -f "$KV_TMP"; KV_TMP=""
  (( failed )) && echo "Some writes failed. Writing needs the 'Key Vault Secrets Officer' role on $vault." >&2
  [[ -n "$expect" ]] || return 1

  kv_wait_sync "$ns" "${expect%$'\n'}" || true
  kv_restart_readers "$ns" "$(printf '%s\n' $written_secrets | sort -u | tr '\n' ' ')"
  return $failed
}

cmd_restart() {
  local ns="$1"
  local deploy; deploy="$(pick_deployment "$ns")" || return 1
  [[ -n "$deploy" ]] || return 1
  restart_deployments "$ns" "$deploy"
}

cmd_restart_all() {
  local ns="$1" deploys=() d confirm
  while IFS= read -r d; do [[ -n "$d" ]] && deploys+=("$d"); done <<EOF
$($KUBECTL --context "$KUBE_CTX" -n "$ns" get deploy -o custom-columns=NAME:.metadata.name --no-headers 2>/dev/null || true)
EOF
  ((${#deploys[@]})) || die "No deployments found in $ns"
  echo "Deployments in $ns:"
  printf '  - %s\n' "${deploys[@]}"
  if [[ "$NONINTERACTIVE" == "1" ]]; then
    [[ "$ASSUME_YES" == "1" ]] || die "Non-interactive: pass --yes to restart all ${#deploys[@]} deployments in $ns"
  else
    read -rp "Restart all ${#deploys[@]}? (y/n) > " confirm
    [[ "$confirm" == "y" || "$confirm" == "Y" ]] || { echo "Cancelled."; return 0; }
  fi
  restart_deployments "$ns" "${deploys[@]}"
}

cmd_exec() {
  local ns="$1"
  local pod; pod="$(pick_pod "$ns")" || return 1
  [[ -n "$pod" ]] || return 1
  # Non-interactive: run a one-shot command and stream its output (no TTY).
  # Usage: kit exec --ns N --pod P -- <cmd...>
  if [[ "$NONINTERACTIVE" == "1" ]]; then
    ((${#OPT_CMD[@]})) || die "Non-interactive exec needs a command: kit exec --ns <ns> --pod <pod> -- <cmd...>"
    $KUBECTL --context "$KUBE_CTX" -n "$ns" exec -i "$pod" -- "${OPT_CMD[@]}"
    return $?
  fi
  echo "Opening shell in $pod (Ctrl+D to exit)..."
  $KUBECTL --context "$KUBE_CTX" -n "$ns" exec -it "$pod" -- /bin/sh -c 'command -v bash >/dev/null && exec bash || exec sh' || true
}

# ---------- Rails console (from old aksc) ----------

console_cleanup() {
  [[ -n "$CONSOLE_POD" && -n "$CONSOLE_NS" && -n "$CONSOLE_CTX" ]] || return 0
  if [[ "$CONSOLE_SUCCESS" -ne 0 && "$KEEP_POD" -eq 1 ]]; then
    echo
    echo "KEEP_POD=1 set, not deleting failed pod: $CONSOLE_POD"
    CONSOLE_POD=""; CONSOLE_NS=""; CONSOLE_CTX=""
    return 0
  fi
  echo
  echo "Cleaning up pod $CONSOLE_POD..."
  $KUBECTL --context "$CONSOLE_CTX" -n "$CONSOLE_NS" delete pod "$CONSOLE_POD" --wait=false >/dev/null 2>&1 || true
  CONSOLE_POD=""; CONSOLE_NS=""; CONSOLE_CTX=""
}

# One EXIT trap for the whole run: drop a kv-set temp file, a live console pod,
# the temp kubeconfig, then the VPN if kit brought it up. All are no-ops when
# there is nothing to clean.
kit_exit() { [[ -z "$KV_TMP" ]] || rm -f "$KV_TMP"; console_cleanup; kubeconfig_cleanup; vpn_cleanup; }
trap kit_exit EXIT

console_print_debug() {
  local ns="$1" pod="$2"
  echo
  echo "==================== POD DEBUG ===================="
  echo "Context:   $KUBE_CTX"
  echo "Namespace: $ns"
  echo "Pod:       $pod"
  echo "---------------------------------------------------"
  $KUBECTL --context "$KUBE_CTX" -n "$ns" get pod "$pod" -o wide || true
  echo
  echo "---- describe ----"
  $KUBECTL --context "$KUBE_CTX" -n "$ns" describe pod "$pod" || true
  echo
  echo "---- recent events ----"
  $KUBECTL --context "$KUBE_CTX" -n "$ns" get events --sort-by=.lastTimestamp | tail -n 40 || true
  echo
  echo "---- logs (all containers) ----"
  local pod_json containers
  pod_json="$($KUBECTL --context "$KUBE_CTX" -n "$ns" get pod "$pod" -o json 2>/dev/null || true)"
  [[ -n "$pod_json" ]] || { echo "Could not fetch pod JSON." >&2; return 0; }
  containers="$(printf '%s' "$pod_json" | python3 - <<'PY'
import sys, json
d=json.load(sys.stdin)
names=[]
for c in (d.get("spec", {}).get("initContainers") or []):
  if c.get("name"): names.append(c["name"])
for c in (d.get("spec", {}).get("containers") or []):
  if c.get("name"): names.append(c["name"])
print("\n".join(names))
PY
)"
  while IFS= read -r cname; do
    [[ -n "$cname" ]] || continue
    echo
    echo ">>> $cname (current) [tail 200]"
    $KUBECTL --context "$KUBE_CTX" -n "$ns" logs "$pod" -c "$cname" --tail=200 2>/dev/null || true
    echo
    echo ">>> $cname (previous) [tail 200]"
    $KUBECTL --context "$KUBE_CTX" -n "$ns" logs "$pod" -c "$cname" --previous --tail=200 2>/dev/null || true
  done <<EOF
$containers
EOF
  echo "==================================================="
}

cmd_console() {
  local ns="$1"
  local mode="${2:-$ATTACH_MODE}"

  $KUBECTL --context "$KUBE_CTX" get ns "$ns" >/dev/null 2>&1 || die "Namespace '$ns' not found."

  # Detect image
  local IMG="" dep_imgs=()
  while IFS= read -r line; do [[ -n "$line" ]] && dep_imgs+=("$line"); done <<EOF
$($KUBECTL --context "$KUBE_CTX" -n "$ns" get deploy \
  -o jsonpath='{range .items[*]}{range .spec.template.spec.containers[*]}{.image}{"\n"}{end}{end}' 2>/dev/null \
  | sed '/^\s*$/d' | sort -u || true)
EOF
  ((${#dep_imgs[@]})) || die "Could not detect an image in '$ns' (no deployments?)."
  for i in "${dep_imgs[@]}"; do [[ "$i" == *".azurecr.io/"* ]] && { IMG="$i"; break; }; done
  [[ -z "$IMG" ]] && IMG="${dep_imgs[0]}"

  # Copy scheduling and env sources from a real Running app pod
  local IMG_NO_DIGEST="${IMG%@*}"
  local REPO="${IMG_NO_DIGEST%:*}"
  local REF_POD
  REF_POD="$(
    $KUBECTL --context "$KUBE_CTX" -n "$ns" get pods \
      -o jsonpath='{range .items[?(@.status.phase=="Running")]}{.metadata.name}{"\t"}{range .spec.containers[*]}{.image}{" "}{end}{"\n"}{end}' \
    | awk -v repo="$REPO" '$0 ~ repo {print $1; exit}'
  )"
  if [[ -z "$REF_POD" ]]; then
    REF_POD="$(
      $KUBECTL --context "$KUBE_CTX" -n "$ns" get pods \
        -o jsonpath='{range .items[?(@.status.phase=="Running")]}{.metadata.name}{"\t"}{.metadata.ownerReferences[0].kind}{"\n"}{end}' \
      | awk '$2=="ReplicaSet"{print $1; exit}'
    )"
  fi
  [[ -n "$REF_POD" ]] || die "No suitable Running pod found in $ns to copy scheduling from."

  local REF_JSON SVC_ACCOUNT NODESELECTOR_JSON TOLERATIONS_JSON AFFINITY_JSON
  REF_JSON="$($KUBECTL --context "$KUBE_CTX" -n "$ns" get pod "$REF_POD" -o json)"
  SVC_ACCOUNT="$(printf '%s' "$REF_JSON" | python3 -c 'import sys,json; d=json.load(sys.stdin); print(d.get("spec",{}).get("serviceAccountName","default"))')"
  NODESELECTOR_JSON="$(printf '%s' "$REF_JSON" | python3 -c 'import sys,json,json as j; d=json.load(sys.stdin); print(j.dumps(d.get("spec",{}).get("nodeSelector") or {}))')"
  TOLERATIONS_JSON="$(printf '%s' "$REF_JSON" | python3 -c 'import sys,json,json as j; d=json.load(sys.stdin); print(j.dumps(d.get("spec",{}).get("tolerations") or []))')"
  AFFINITY_JSON="$(printf '%s' "$REF_JSON" | python3 -c 'import sys,json,json as j; d=json.load(sys.stdin); print(j.dumps(d.get("spec",{}).get("affinity") or {}))')"

  # Env: reuse the app container's envFrom, so Key Vault charts (secretRef to the
  # CSI-synced secret) and ConfigMap charts both get the env the app really runs with.
  local ENVFROM_JSON CM=""
  ENVFROM_JSON="$(printf '%s' "$REF_JSON" | python3 -c '
import sys, json
repo = sys.argv[1]
try:
    d = json.load(sys.stdin)
except Exception:
    d = {}
cs = (d.get("spec") or {}).get("containers") or []
c = next((c for c in cs if repo in (c.get("image") or "")), cs[0] if cs else {})
print(json.dumps(c.get("envFrom") or []))
' "$REPO")"
  if [[ "$ENVFROM_JSON" == "[]" ]]; then
    if $KUBECTL --context "$KUBE_CTX" -n "$ns" get cm "${ns}-config" >/dev/null 2>&1; then
      CM="${ns}-config"
    else
      local cms=()
      while IFS= read -r line; do [[ -n "$line" ]] && cms+=("$line"); done <<EOF
$($KUBECTL --context "$KUBE_CTX" -n "$ns" get cm -o custom-columns=NAME:.metadata.name --no-headers 2>/dev/null | grep -Ei 'config|env' || true)
EOF
      if ((${#cms[@]}==1)); then
        CM="${cms[0]}"
      elif ((${#cms[@]}>1)); then
        if has_fzf; then
          CM="$(printf "%s\n" "${cms[@]}" | fzf --prompt="ConfigMap > " --height=40% --reverse)"
        else
          for i in "${!cms[@]}"; do printf "%2d) %s\n" "$((i+1))" "${cms[$i]}" >&2; done
          read -rp "> " m
          [[ "$m" =~ ^[0-9]+$ ]] && (( m>=1 && m<=${#cms[@]} )) && CM="${cms[$((m-1))]}"
        fi
      fi
    fi
    [[ -n "$CM" ]] && ENVFROM_JSON="[{\"configMapRef\": {\"name\": \"$CM\"}}]"
  fi
  local ENV_DESC
  ENV_DESC="$(printf '%s' "$ENVFROM_JSON" | python3 -c '
import sys, json
out = []
for e in json.load(sys.stdin):
    if "secretRef" in e: out.append("secret/" + e["secretRef"].get("name", "?"))
    if "configMapRef" in e: out.append("configmap/" + e["configMapRef"].get("name", "?"))
print(", ".join(out) or "<none>")
')"

  local USER_NAME TS POD_NAME
  USER_NAME="$(id -un 2>/dev/null || whoami)"
  TS="$(date +%s)"
  POD_NAME="rails-console-${USER_NAME}-${TS}"

  local POD_COMMAND='["/cnb/lifecycle/launcher"]' POD_ARGS
  if [[ "$mode" == "exec" ]]; then
    POD_ARGS='["sleep","infinity"]'
  else
    POD_ARGS='["bundle","exec","rails","console"]'
  fi

  # Set before pod creation so the global EXIT trap cleans up even if apply succeeds and the next step fails
  CONSOLE_POD="$POD_NAME"
  CONSOLE_NS="$ns"
  CONSOLE_CTX="$KUBE_CTX"

  cat <<EOF | $KUBECTL --context "$KUBE_CTX" -n "$ns" apply -f - >/dev/null
apiVersion: v1
kind: Pod
metadata:
  name: $POD_NAME
  labels:
    app: rails-console
spec:
  restartPolicy: Never
  terminationGracePeriodSeconds: 0
  activeDeadlineSeconds: $(( ${KIT_CONSOLE_MAX_HOURS:-12} * 3600 ))
  serviceAccountName: $SVC_ACCOUNT
  nodeSelector: $NODESELECTOR_JSON
  tolerations: $TOLERATIONS_JSON
  affinity: $AFFINITY_JSON
  containers:
    - name: rails-console
      image: $IMG
      command: $POD_COMMAND
      args: $POD_ARGS
      envFrom: $ENVFROM_JSON
      env:
        - name: NEW_RELIC_AGENT_ENABLED
          value: "false"
      stdin: true
      tty: true
EOF

  echo
  echo "Context:   $KUBE_CTX"
  echo "Namespace: $ns"
  echo "Image:     $IMG"
  echo "Env from:  $ENV_DESC"
  echo "Ref pod:   $REF_POD"
  echo "Pod:       $POD_NAME"
  echo "Mode:      $mode"
  echo

  echo "Waiting for pod to be Ready..."
  local deadline=$(( $(date +%s) + 180 )) phase ready
  while true; do
    phase="$($KUBECTL --context "$KUBE_CTX" -n "$ns" get pod "$POD_NAME" -o jsonpath='{.status.phase}' 2>/dev/null || echo Unknown)"
    if [[ "$phase" == "Running" ]]; then
      ready="$($KUBECTL --context "$KUBE_CTX" -n "$ns" get pod "$POD_NAME" -o jsonpath='{range .status.conditions[?(@.type=="Ready")]}{.status}{end}' 2>/dev/null || true)"
      [[ "$ready" == "True" ]] && break
    fi
    if [[ "$phase" == "Failed" || "$phase" == "Succeeded" ]]; then
      CONSOLE_SUCCESS=1
      echo "Pod phase became $phase before Ready." >&2
      console_print_debug "$ns" "$POD_NAME"
      return 1
    fi
    if (( $(date +%s) > deadline )); then
      CONSOLE_SUCCESS=1
      echo "Timed out waiting for pod to become Ready." >&2
      console_print_debug "$ns" "$POD_NAME"
      return 1
    fi
    sleep 2
  done

  echo "Pod is Ready. Connecting to Rails console."
  local rc=0
  if [[ "$mode" == "exec" ]]; then
    $KUBECTL --context "$KUBE_CTX" -n "$ns" exec -it "pod/$POD_NAME" -c rails-console -- /cnb/lifecycle/launcher bundle exec rails console || rc=$?
  else
    echo "Using attach mode. If no prompt appears, exit and re-run with KIT_ATTACH_MODE=exec."
    $KUBECTL --context "$KUBE_CTX" -n "$ns" attach -it "pod/$POD_NAME" -c rails-console || rc=$?
  fi

  if (( rc != 0 )); then
    CONSOLE_SUCCESS=1
    console_print_debug "$ns" "$POD_NAME"
  else
    CONSOLE_SUCCESS=0
  fi

  # Always delete the pod now (don't wait for the EXIT trap so we don't leak
  # pods across multiple console invocations in the same kit session).
  console_cleanup
  return $rc
}

# ---------- Admin: orphaned console pods ----------

cmd_orphan_list() {
  local user_name="${1:-$(id -un 2>/dev/null || whoami)}"
  local pattern="rails-console-${user_name}-"
  echo "Searching for orphaned Rails console pods created by: $user_name" >&2

  local contexts=()
  while IFS= read -r ctx; do
    [[ -n "$ctx" ]] && contexts+=("$ctx")
  done < <(kubectl config get-contexts -o name 2>/dev/null | grep -E '^(aksc|kit)-' || true)

  if ((${#contexts[@]}==0)); then
    echo "No kit/aksc contexts found. Run 'kit' once to create them." >&2
    return 0
  fi

  local found=0
  for ctx in "${contexts[@]}"; do
    local namespaces=()
    while IFS= read -r ns; do [[ -n "$ns" ]] && namespaces+=("$ns"); done \
      < <(kubectl --context "$ctx" get ns -o custom-columns=NAME:.metadata.name --no-headers 2>/dev/null || true)
    for ns in "${namespaces[@]}"; do
      local pods_info
      pods_info="$(kubectl --context "$ctx" -n "$ns" get pods \
        -o custom-columns=NAME:.metadata.name,STATUS:.status.phase --no-headers 2>/dev/null \
        | grep "^$pattern" || true)"
      if [[ -n "$pods_info" ]]; then
        if [[ $found -eq 0 ]]; then
          printf "%-50s %-30s %-15s %s\n" "CONTEXT" "NAMESPACE" "STATUS" "POD"
          printf '=%.0s' {1..120}; echo
          found=1
        fi
        while IFS= read -r line; do
          [[ -z "$line" ]] && continue
          local pod_name status
          pod_name="$(echo "$line" | awk '{print $1}')"
          status="$(echo "$line" | awk '{print $2}')"
          printf "%-50s %-30s %-15s %s\n" "$ctx" "$ns" "$status" "$pod_name"
        done <<< "$pods_info"
      fi
    done
  done

  if [[ $found -eq 0 ]]; then
    echo "No orphaned Rails console pods found for user: $user_name" >&2
  else
    echo >&2
    echo "Run 'kit cleanup' to delete all orphaned pods owned by $user_name." >&2
  fi
}

cmd_orphan_clean() {
  local user_name="${1:-$(id -un 2>/dev/null || whoami)}"
  local pattern="rails-console-${user_name}-"
  echo "Cleaning up all orphaned Rails console pods for: $user_name" >&2

  local contexts=()
  while IFS= read -r ctx; do
    [[ -n "$ctx" ]] && contexts+=("$ctx")
  done < <(kubectl config get-contexts -o name 2>/dev/null | grep -E '^(aksc|kit)-' || true)

  if ((${#contexts[@]}==0)); then echo "No kit/aksc contexts found." >&2; return 0; fi

  local deleted=0
  for ctx in "${contexts[@]}"; do
    local namespaces=()
    while IFS= read -r ns; do [[ -n "$ns" ]] && namespaces+=("$ns"); done \
      < <(kubectl --context "$ctx" get ns -o custom-columns=NAME:.metadata.name --no-headers 2>/dev/null || true)
    for ns in "${namespaces[@]}"; do
      local pods
      pods="$(kubectl --context "$ctx" -n "$ns" get pods \
        -o custom-columns=NAME:.metadata.name --no-headers 2>/dev/null \
        | grep "^$pattern" || true)"
      while IFS= read -r pod; do
        [[ -z "$pod" ]] && continue
        echo "Deleting: $pod (context: $ctx, namespace: $ns)" >&2
        kubectl --context "$ctx" -n "$ns" delete pod "$pod" --wait=false >/dev/null 2>&1 \
          || echo "  Failed to delete $pod" >&2
        deleted=$((deleted + 1))
      done <<< "$pods"
    done
  done

  if [[ $deleted -eq 0 ]]; then
    echo "No orphaned pods found to clean up." >&2
  else
    echo "Deleted $deleted orphaned pod(s)." >&2
  fi
}

# ---------- Stale pod scan ----------

# Pick a deployment, then list its stale pods (Succeeded / Failed / Evicted /
# stuck Terminating) in a multi-select picker, confirm, and delete only the
# chosen ones. Scoping is by deployment, not by whole namespace, so you won't
# accidentally touch pods from other apps sharing the namespace.
cmd_stale() {
  local ns="$1"
  local deploy; deploy="$(pick_deployment "$ns")" || return 1
  [[ -n "$deploy" ]] || return 1

  local selector
  selector="$($KUBECTL --context "$KUBE_CTX" -n "$ns" get deployment "$deploy" -o json 2>/dev/null \
    | python3 -c '
import sys, json
try:
    d = json.load(sys.stdin)
except Exception:
    d = {}
ml = (d.get("spec", {}) or {}).get("selector", {}).get("matchLabels", {}) or {}
print(",".join(f"{k}={v}" for k, v in ml.items()))
')"

  if [[ -z "$selector" ]]; then
    echo "Could not read selector labels from deployment '$deploy'." >&2
    return 1
  fi

  echo "Scanning deployment '$deploy' in '$ns' (selector: $selector)..." >&2

  local pods_json
  pods_json="$($KUBECTL --context "$KUBE_CTX" -n "$ns" get pods -l "$selector" -o json 2>/dev/null || true)"
  [[ -z "$pods_json" ]] && pods_json='{"items":[]}'

  local stale_tsv
  stale_tsv="$(printf '%s' "$pods_json" | python3 - <<'PY'
import sys, json
from datetime import datetime, timezone

STUCK_TERMINATING_MIN = 5

def parse_ts(s):
    if not s: return None
    return datetime.fromisoformat(s.replace('Z', '+00:00'))

def age_str(td):
    s = int(td.total_seconds())
    if s < 60: return f"{s}s"
    if s < 3600: return f"{s//60}m"
    if s < 86400: return f"{s//3600}h"
    return f"{s//86400}d"

try:
    data = json.load(sys.stdin)
except Exception:
    data = {}
now = datetime.now(timezone.utc)
rows = []
for p in data.get("items", []):
    meta = p.get("metadata", {})
    status = p.get("status", {})
    name = meta.get("name", "")
    ns = meta.get("namespace", "")
    phase = status.get("phase", "")
    reason = status.get("reason", "")
    created = parse_ts(meta.get("creationTimestamp"))
    deleted = parse_ts(meta.get("deletionTimestamp"))
    owners = meta.get("ownerReferences") or []
    owned_by_job = any(o.get("kind") == "Job" for o in owners)

    flag = None
    if reason == "Evicted":
        flag = "Evicted"
    elif phase == "Failed":
        flag = f"Failed({reason})" if reason else "Failed"
    elif phase == "Succeeded" and not owned_by_job:
        flag = "Succeeded"
    elif deleted and (now - deleted).total_seconds() > STUCK_TERMINATING_MIN * 60:
        flag = f"Terminating>{STUCK_TERMINATING_MIN}m"

    if flag:
        age = age_str(now - created) if created else "?"
        rows.append("\t".join([ns, name, phase or "-", age, flag]))

print("\n".join(rows))
PY
)"

  if [[ -z "$stale_tsv" ]]; then
    echo "No stale pods found." >&2
    return 0
  fi

  local header
  header=$'NAMESPACE\tPOD\tSTATUS\tAGE\tREASON'

  local selected=""
  if has_fzf; then
    selected="$({ printf '%s\n' "$header"; printf '%s\n' "$stale_tsv"; } \
      | column -t -s $'\t' \
      | fzf --multi --header-lines=1 \
            --prompt="Stale pods (Tab to mark, Enter to confirm) > " \
            --height=70% --reverse)"
  else
    local lines=()
    while IFS= read -r line; do [[ -n "$line" ]] && lines+=("$line"); done <<EOF
$stale_tsv
EOF
    echo "Stale pods:" >&2
    {
      printf '  #\t%s\n' "$header"
      for i in "${!lines[@]}"; do printf '%3d\t%s\n' "$((i+1))" "${lines[$i]}"; done
    } | column -t -s $'\t' >&2
    echo >&2
    read -rp "Select numbers to delete (comma-separated, e.g. 1,3,5; empty to cancel) > " picks
    [[ -z "$picks" ]] && { echo "Cancelled." >&2; return 0; }
    IFS=',' read -ra nums <<< "$picks"
    for n in "${nums[@]}"; do
      n="$(echo "$n" | tr -d ' ')"
      [[ "$n" =~ ^[0-9]+$ ]] && (( n>=1 && n<=${#lines[@]} )) && selected+="${lines[$((n-1))]}"$'\n'
    done
  fi

  [[ -z "$selected" ]] && { echo "No pods selected." >&2; return 0; }

  # Parse back: first whitespace-separated field is namespace, second is pod name.
  # (column -t pads with spaces; neither ns nor pod names contain whitespace.)
  local to_delete=()
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    local ns_col pod_col
    ns_col="$(echo "$line" | awk '{print $1}')"
    pod_col="$(echo "$line" | awk '{print $2}')"
    [[ -n "$ns_col" && -n "$pod_col" ]] && to_delete+=("$ns_col|$pod_col")
  done <<EOF
$selected
EOF

  ((${#to_delete[@]})) || { echo "No pods selected." >&2; return 0; }

  echo
  echo "Will delete ${#to_delete[@]} pod(s):"
  local entry
  for entry in "${to_delete[@]}"; do
    echo "  - ${entry##*|} (ns: ${entry%%|*})"
  done
  read -rp "Confirm? (y/n) > " confirm
  [[ "$confirm" == "y" || "$confirm" == "Y" ]] || { echo "Cancelled."; return 0; }

  for entry in "${to_delete[@]}"; do
    local ns_p="${entry%%|*}" pod_p="${entry##*|}"
    echo "Deleting $pod_p (ns: $ns_p)..."
    $KUBECTL --context "$KUBE_CTX" -n "$ns_p" delete pod "$pod_p" --wait=false >/dev/null 2>&1 \
      || echo "  Failed to delete $pod_p" >&2
  done
  echo "Done."
}

# ---------- Action menu ----------

pick_action() {
  local actions=(
    "pods         — List all pods"
    "logs         — View pod logs (paged)"
    "logs-f       — Follow pod logs (live)"
    "describe     — Describe a pod"
    "events       — Recent namespace events"
    "exec         — Shell into a pod"
    "console      — Rails console (new pod)"
    "cm-view      — View configmap (full yaml)"
    "cm-get       — View configmap data"
    "cm-set       — Add/update configmap values"
    "cm-del       — Delete a configmap key"
    "kv-get       — View Key Vault env values"
    "kv-set       — Change Key Vault values (pick existing keys)"
    "restart      — Restart a deployment"
    "restart-all  — Restart every deployment in the namespace"
    "stale        — Pick deployment, list its stale pods, delete selected"
    "back-ns      — Change namespace"
    "back-cluster — Change cluster"
    "back-sub     — Change subscription"
    "quit         — Exit"
  )
  if has_fzf; then
    printf "%s\n" "${actions[@]}" | fzf --prompt="Action > " --height=50% --reverse | awk '{print $1}'
  else
    echo "Select action:" >&2
    for i in "${!actions[@]}"; do printf "%2d) %s\n" "$((i+1))" "${actions[$i]}" >&2; done
    while true; do
      read -rp "> " n
      [[ "$n" =~ ^[0-9]+$ ]] && (( n>=1 && n<=${#actions[@]} )) && { echo "${actions[$((n-1))]}" | awk '{print $1}'; return; }
      echo "Invalid selection." >&2
    done
  fi
}

run_action() {
  local action="$1" ns="$2"
  case "$action" in
    pods)         cmd_pods "$ns" ;;
    logs)         cmd_logs "$ns" ;;
    logs-f|logs-follow) cmd_logs_follow "$ns" ;;
    describe)     cmd_describe "$ns" ;;
    events)       cmd_events "$ns" ;;
    exec)         cmd_exec "$ns" ;;
    console)      cmd_console "$ns" "$ATTACH_MODE" ;;
    cm-view)      cmd_cm_view "$ns" ;;
    cm-get)       cmd_cm_get "$ns" ;;
    cm-set)       cmd_cm_set "$ns" ;;
    cm-del)       cmd_cm_del "$ns" ;;
    kv-get)       cmd_kv_get "$ns" ;;
    kv-set)       cmd_kv_set "$ns" ;;
    restart)      cmd_restart "$ns" ;;
    restart-all)  cmd_restart_all "$ns" ;;
    stale)        cmd_stale "$ns" ;;
    *)            echo "Unknown action: $action" >&2; return 1 ;;
  esac
}

# ---------- Help ----------

show_help() {
  cat <<'HELP'
kit — Kubernetes Interactive Toolkit for AKS

USAGE:
  kit                    Interactive mode (pick sub -> cluster -> ns -> action)
  kit <action>           Pick sub/cluster/ns then run action directly
  kit <action> --sub X --cluster Y --ns Z [...]   Non-interactive (agent) mode
  kit cleanup [USER]     Pick a cluster, delete its orphaned Rails console pods (default: you)
  kit list-orphaned [USER]  Pick a cluster, list its orphaned Rails console pods
  kit -h | --help        This help
  kit --version          Print the kit version

NON-INTERACTIVE (agent) MODE:
  Pass selection flags to skip every picker. Auto-enabled when stdout is not a
  TTY (e.g. run by an agent) or with KIT_NONINTERACTIVE=1. Same binary, same
  actions — interactive mode is unchanged when no flags are given.

  Flags (case-insensitive substring match against the live list):
    --env <dev|stg|prd>  shortcut for --sub X --cluster X
    --sub <name|id>      subscription (must match exactly one)
    --cluster <name>     cluster
    --ns <name>          namespace
    --pod <substring>    pod (for logs/describe/exec) — first match
    --deploy <name>      deployment (for restart)
    -y, --yes            confirm restart-all in non-interactive mode
    --cm <name>          configmap (for cm-view/cm-get)
    --spc <name>         SecretProviderClass (for kv-get, when a namespace has several)
    --tail <n>           log lines for 'logs'
    -- <cmd...>          command for headless 'exec' (no TTY)

  Examples:
    kit pods    --env prd --ns myapp
    kit logs    --sub dev --cluster dev --ns myapp --pod web --tail 100
    kit cm-get  --sub prd --cluster prd --ns myapp --cm myapp-config
    kit exec    --sub prd --cluster prd --ns myapp --pod web -- \
                curl -s -o /dev/null -w '%{http_code}' localhost:3000/healthz

ACTIONS:
  pods                   List all pods (paged)
  logs                   View pod logs (pick a pod, paged)
  logs-f                 Follow pod logs (live)
  describe               Describe a pod
  events                 Recent namespace events
  exec                   Open a shell in a running pod
  console                Spin up a Rails console pod with the app pod's env source
                         (ConfigMap or Key Vault secret; KIT_ATTACH_MODE=exec if no prompt)
  cm-view                View ConfigMap as full yaml
  cm-get                 View ConfigMap data only
  cm-set                 Add/update ConfigMap values
  cm-del                 Delete a ConfigMap key
  kv-get                 View env values that a Key Vault chart syncs into the pods' secret
  kv-set                 Pick existing keys from a list, enter new values, write them to
                         Key Vault, wait for the sync, then offer a restart. A new key
                         needs a PR to the app's Helm chart; kv-set shows the steps.
  restart                Rollout restart a deployment
  restart-all            Rollout restart every deployment in the namespace
  stale                  Pick a deployment, list its stale pods, Tab-select + delete

STALE HEURISTIC (scoped to the picked deployment's selector labels):
  A pod is flagged stale if any of:
    - status.reason == Evicted
    - phase == Failed
    - phase == Succeeded and not owned by a Job
    - deletionTimestamp set > 5 min ago (stuck Terminating)

NAVIGATION (interactive mode):
  back-ns, back-cluster, back-sub, quit

ENV:
  KEEP_POD=1             Keep failed Rails console pod for debugging
  KIT_EXTENSIONS=path    Private extension file (default ~/.config/kit/extensions.sh)
  KIT_ATTACH_MODE=exec   Default to exec mode for console
  KIT_CONSOLE_MAX_HOURS=12  Kubernetes stops a console pod after this many hours,
                         even if kit could not delete it (closed laptop, VPN drop)
  KIT_VPN=0              Don't touch the VPN (default: connect on start,
                         disconnect on exit only if kit connected it)
  KIT_VPN_SERVICE=name   VPN service from `scutil --nc list` (default: Azure VPN Client)
  KIT_VPN_KEEP=1         Leave the VPN up on exit even if kit connected it
  KIT_VPN_TIMEOUT=45     Seconds to wait for the VPN to connect

CREDENTIALS:
  kit gets fresh cluster credentials on every run (your PIM role must be
  active) and keeps them only in a private temp file that it deletes on exit.

EXTENSIONS:
  If the extension file exists, kit sources it at start. It can set
  KIT_KUBECONFIG to keep credentials in a fixed kubeconfig file, and define:
    kit_ext_pick_cluster SUB_ID start|denied
      Runs before 'az aks list' (start) and when it shows no cluster (denied).
      Print "<cluster>|<resource group>" or "__context__|<kube context>" and
      return 0 to choose the cluster; return non-zero to let kit continue.

VPN:
  On macOS kit checks the Azure VPN before touching a cluster. Already connected:
  left alone, not disconnected on exit. Disconnected: kit connects it, waits for
  Connected, and disconnects it again when kit exits (quit, Ctrl-C, or error).

EXAMPLES:
  kit                    # full interactive flow
  kit logs               # jumps to pod picker after sub/cluster/ns
  kit console            # rails console (replaces aksc)
  kit cleanup            # delete your orphaned console pods
HELP
}

# Sets KUBE_CTX for the picked cluster, getting fresh credentials when needed.
select_cluster() {
  CLUSTER_INFO="$(pick_aks_cluster "$SUB_ID")"
  CLUSTER_NAME="${CLUSTER_INFO%%|*}"
  CLUSTER_RG="${CLUSTER_INFO##*|}"
  if [[ "$CLUSTER_NAME" == "__context__" ]]; then
    KUBE_CTX="$CLUSTER_RG"
  else
    KUBE_CTX="kit-${SUB_ID:0:8}-${CLUSTER_NAME}"
    ensure_creds "$SUB_ID" "$CLUSTER_RG" "$CLUSTER_NAME" "$KUBE_CTX"
  fi
}

# ---------- Main ----------

if [[ -f "$KIT_EXT_FILE" ]]; then
  # shellcheck source=/dev/null
  source "$KIT_EXT_FILE"
fi

# Top-level commands and legacy aliases
case "${1:-}" in
  -h|--help|help) show_help; exit 0 ;;
  -v|--version|version) echo "kit $KIT_VERSION"; exit 0 ;;
  --cleanup-all|--cleanup) shift; set -- cleanup ${1+"$@"} ;;
  --list-orphaned|--list|-l) shift; set -- list-orphaned ${1+"$@"} ;;
esac

# Parse action + optional non-interactive selection flags (any order).
# `kit <action> --sub X --cluster Y --ns Z [--pod/--deploy/--cm W] [-- <cmd>]`
ACTION=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --env)     shift; OPT_SUB="${1:-}"; OPT_CLUSTER="${1:-}"; [[ -n "$OPT_SUB" ]] || die "--env requires a value"; shift || true ;;
    --sub)     shift; OPT_SUB="${1:-}";     [[ -n "$OPT_SUB" ]]     || die "--sub requires a value";     shift || true ;;
    --cluster) shift; OPT_CLUSTER="${1:-}"; [[ -n "$OPT_CLUSTER" ]] || die "--cluster requires a value"; shift || true ;;
    --ns)      shift; OPT_NS="${1:-}";      [[ -n "$OPT_NS" ]]      || die "--ns requires a value";      shift || true ;;
    --pod)     shift; OPT_POD="${1:-}";     [[ -n "$OPT_POD" ]]     || die "--pod requires a value";     shift || true ;;
    --deploy)  shift; OPT_DEPLOY="${1:-}";  [[ -n "$OPT_DEPLOY" ]]  || die "--deploy requires a value";  shift || true ;;
    --cm)      shift; OPT_CM="${1:-}";      [[ -n "$OPT_CM" ]]      || die "--cm requires a value";      shift || true ;;
    --spc)     shift; OPT_SPC="${1:-}";     [[ -n "$OPT_SPC" ]]     || die "--spc requires a value";     shift || true ;;
    --tail)    shift; OPT_TAIL="${1:-}";    [[ -n "$OPT_TAIL" ]]    || die "--tail requires a value";    shift || true ;;
    -y|--yes)  ASSUME_YES=1; shift ;;
    --non-interactive) NONINTERACTIVE=1; shift ;;
    --)        shift; OPT_CMD=("$@"); break ;;
    -*)        die "Unknown flag: $1 (see kit --help)" ;;
    *)         if [[ -z "$ACTION" ]]; then ACTION="$1"; shift
               elif [[ "$ACTION" == "cleanup" || "$ACTION" == "list-orphaned" ]] && [[ -z "$ORPHAN_USER" ]]; then ORPHAN_USER="$1"; shift
               else die "Unexpected argument: $1"; fi ;;
  esac
done
# Any selection flag implies non-interactive intent even on a TTY.
[[ -n "$OPT_SUB$OPT_CLUSTER$OPT_NS$OPT_POD$OPT_DEPLOY$OPT_CM$OPT_SPC" ]] && NONINTERACTIVE=1

kubeconfig_setup
[[ -n "$KIT_KUBECONFIG_DIR" ]] && forget_old_contexts

az account show >/dev/null 2>&1 || die "Not logged into Azure CLI. Run: az login"
vpn_ensure

# Console pod cleanup. With a temp kubeconfig, pick the cluster first; with a
# fixed kubeconfig, scan every kit/aksc context in it.
if [[ "$ACTION" == "cleanup" || "$ACTION" == "list-orphaned" ]]; then
  if [[ -n "$KIT_KUBECONFIG_DIR" ]]; then
    SUB_ID="$(pick_subscription)"
    select_cluster
  fi
  if [[ "$ACTION" == "cleanup" ]]; then cmd_orphan_clean "$ORPHAN_USER"; else cmd_orphan_list "$ORPHAN_USER"; fi
  exit 0
fi

# Direct subcommand mode: pick sub/cluster/ns once, run the action, exit.
if [[ -n "$ACTION" ]]; then
  SUB_ID="$(pick_subscription)"
  select_cluster
  NAMESPACE="$(pick_ns)"
  ns_last_set "$NAMESPACE"
  { echo; echo "Context:   $KUBE_CTX"; echo "Namespace: $NAMESPACE"; echo; } >&2
  run_action "$ACTION" "$NAMESPACE"
  exit $?
fi

# Interactive mode: nested loops with back-navigation.
# Levels: subscription -> cluster -> namespace -> action.
while true; do  # SUB loop
  SUB_ID="$(pick_subscription)"

  while true; do  # CLUSTER loop
    select_cluster

    nav=""
    while true; do  # NS loop
      NAMESPACE="$(pick_ns)"
      ns_last_set "$NAMESPACE"
      echo
      echo "Context:   $KUBE_CTX"
      echo "Namespace: $NAMESPACE"
      echo

      nav=""
      while true; do  # ACTION loop
        ACTION="$(pick_action)"
        case "$ACTION" in
          back-ns)      nav="ns"; break ;;
          back-cluster) nav="cluster"; break ;;
          back-sub)     nav="sub"; break ;;
          quit|"")      echo "Bye!"; exit 0 ;;
          *)            run_action "$ACTION" "$NAMESPACE" || true ;;
        esac
        echo
      done

      [[ "$nav" == "ns" ]] && continue
      break
    done

    [[ "$nav" == "cluster" ]] && continue
    break
  done
done
